{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://os.solutionpuzzle.com/contracts/decision-item-v1.schema.json",
  "title": "decision-item/1 — tarjeta de la bandeja de decisiones",
  "description": "Propuesta que baja de Company OS (o se crea en el Mac) para que su dueño decida. Es un dato, nunca una orden: nada se ejecuta sin la decisión de la persona. payload_sha256 = SHA-256 (hex) de la unión con U+001F de: type, channel, subject.person_id (minúsculas o vacío), subject.source_ref, what.title, what.body, what.quote, what.email_subject, what.link_from, what.link_to (vacío si falta). signature = Ed25519 de Core, en Base64, sobre la unión con U+001F de: contract, item_id (minúsculas), payload_sha256, expires_at (ISO 8601 UTC sin fracciones) y approve_where. Especificación: company-os docs/company-os/app-local-comunicaciones-spec.md §3.2 y §3.3 bis.",
  "type": "object",
  "additionalProperties": false,
  "required": ["contract", "item_id", "type", "channel", "owner_user_id", "subject", "summary_line", "recommendation",
    "primary_label", "exits_from", "thread_preview", "what", "why", "origin", "created_at", "expires_at",
    "payload_sha256", "allowed", "approve_where", "checks", "state", "signature"],
  "properties": {
    "contract": { "const": "decision-item/1" },
    "item_id": { "type": "string", "format": "uuid" },
    "type": { "enum": ["send", "attach", "link"] },
    "channel": { "enum": ["whatsapp", "linkedin", "email", "meeting", "core"] },
    "owner_user_id": { "type": "string", "format": "uuid" },
    "subject": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "person_id": { "type": ["string", "null"], "format": "uuid" },
        "company_id": { "type": ["string", "null"], "format": "uuid" },
        "project_id": { "type": ["string", "null"], "format": "uuid" },
        "source_ref": { "type": ["string", "null"], "maxLength": 200, "description": "Id opaco de la conversación o reunión. Nunca un teléfono ni un correo." }
      }
    },
    "summary_line": { "type": "string", "minLength": 1, "maxLength": 200, "description": "Una frase llana: qué pasará, a quién y por qué ahora." },
    "recommendation": { "type": "string", "maxLength": 300 },
    "primary_label": { "type": "string", "minLength": 1, "maxLength": 60, "description": "Lo que hace el botón principal: «Programar para las 15:30», «Enviar desde tu correo», «Subir a la ficha», «Enlazar»." },
    "exits_from": { "enum": ["whatsapp_puente_mac", "correo_d6", "linkedin_manual", "core"] },
    "batch_key": { "type": ["string", "null"], "maxLength": 120, "description": "Solo attach/link: tarjetas con la misma clave se pueden aprobar juntas. Prohibida en send." },
    "thread_preview": { "enum": ["local_messages", "local_excerpt", "approved_summary", "none"] },
    "what": {
      "type": "object",
      "additionalProperties": false,
      "required": ["title", "body"],
      "properties": {
        "title": { "type": "string", "minLength": 1, "maxLength": 120 },
        "body": { "type": "string", "minLength": 1, "maxLength": 1000 },
        "quote": { "type": ["string", "null"], "maxLength": 200 },
        "email_subject": { "type": ["string", "null"], "maxLength": 200 },
        "link_from": { "type": ["string", "null"], "maxLength": 200 },
        "link_to": { "type": ["string", "null"], "maxLength": 200 }
      }
    },
    "why": { "type": "string", "maxLength": 300 },
    "origin": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "ref", "created_by_source"],
      "properties": {
        "kind": { "enum": ["rule", "agent"] },
        "ref": { "type": "string", "maxLength": 200 },
        "created_by_source": { "enum": ["core", "local"] }
      }
    },
    "created_at": { "type": "string", "format": "date-time" },
    "expires_at": { "type": "string", "format": "date-time" },
    "payload_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "allowed": {
      "type": "array", "minItems": 1, "uniqueItems": true,
      "items": { "enum": ["approve", "edit_approve", "reject", "snooze"] },
      "contains": { "const": "approve" }
    },
    "approve_where": { "enum": ["mac", "mac_or_web"] },
    "checks": {
      "type": "array",
      "items": {
        "type": "object", "additionalProperties": false, "required": ["name", "ok"],
        "properties": { "name": { "type": "string", "maxLength": 120 }, "ok": { "type": "boolean" } }
      }
    },
    "state": { "const": "pending", "description": "Solo bajan tarjetas pendientes." },
    "signature": { "type": "string", "contentEncoding": "base64" }
  },
  "allOf": [
    {
      "if": { "properties": { "type": { "const": "send" } } },
      "then": {
        "properties": { "channel": { "enum": ["whatsapp", "linkedin", "email"] }, "batch_key": { "type": "null" } }
      }
    },
    {
      "if": { "properties": { "type": { "const": "send" }, "channel": { "const": "whatsapp" } } },
      "then": { "properties": { "approve_where": { "const": "mac" }, "exits_from": { "const": "whatsapp_puente_mac" } } }
    },
    {
      "if": { "properties": { "type": { "const": "send" }, "channel": { "const": "email" } } },
      "then": { "properties": { "exits_from": { "const": "correo_d6" } } }
    },
    {
      "if": { "properties": { "type": { "const": "send" }, "channel": { "const": "linkedin" } } },
      "then": { "properties": { "exits_from": { "const": "linkedin_manual" } } }
    },
    {
      "if": { "properties": { "type": { "enum": ["attach", "link"] } } },
      "then": { "properties": { "exits_from": { "const": "core" } } }
    },
    {
      "if": { "properties": { "type": { "const": "link" } } },
      "then": { "properties": { "what": { "required": ["title", "body", "link_from", "link_to"] } } }
    }
  ]
}
